# PostgreSQL
# Use the hostname of the external server. For the Docker host itself, use
# host.docker.internal instead of localhost.
DB_HOST=
DB_NAME=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
SQLALCHEMY_DATABASE_URI=

# Digital Ocean Spaces Variables
STORAGE_DRIVER=
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=

# Other variables
TOKEN_SECRET=
DEV_MODE=

# Browser origin allowed by CORS. Pydantic expects a JSON list.
API_CORS_ALLOWED_ORIGINS=["http://127.0.0.1:4321","http://localhost:4321"]

# Cache: use "memory" locally or "valkey" when a server is available.
CACHE_BACKEND=memory
CACHE_URL=valkey://localhost:6379/0
CACHE_KEY_PREFIX=free-win:orders:
CACHE_SOCKET_TIMEOUT_SECONDS=2
CACHE_SOCKET_CONNECT_TIMEOUT_SECONDS=2

# Temporary local identity. Keep disabled unless developing locally.
AUTH_MODE=disabled
AUTH_LOCAL_USER_ID=

# Docker Compose binds the API only to localhost.
FREE_WIN_API_PORT=8000
FREE_WIN_API_MEMORY_LIMIT=512m
FREE_WIN_API_CPU_LIMIT=0.75
FREE_WIN_API_PIDS_LIMIT=256
FREE_WIN_WORKER_MEMORY_LIMIT=256m
FREE_WIN_WORKER_CPU_LIMIT=0.5
FREE_WIN_WORKER_PIDS_LIMIT=128
